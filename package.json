{
  "name": "asmi-bae.github.io",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "vite",
    "encrypt:data": "node scripts/encrypt-portfolio-data.mjs",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "cdn:fetch-images": "node scripts/fetch-images.mjs",
    "cdn:sync": "node scripts/sync-images-to-r2.mjs",
    "cdn:deploy": "npm run deploy --prefix workers/image-cdn",
    "cdn:verify": "node scripts/verify-cdn.mjs",
    "cdn:upload": "node scripts/upload-images-cloudinary.mjs",
    "cdn:setup": "node scripts/setup-cdn.mjs && pnpm cdn:fetch-images && cd workers/image-cdn && npm ci && npx wrangler r2 bucket create portfolio-images || true && cd ../.. && pnpm cdn:sync && pnpm cdn:deploy",
    "test:unit": "node --test scripts/images.test.mjs"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.2",
    "dompurify": "^3.4.17",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.27",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "8.4.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}